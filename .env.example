# Soval AI — environment variables
# Copy to .env.local for local dev, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.

# ── Booking calendar ────────────────────────────────────────────────
# Your Cal.com or Calendly booking URL, with $79 payment enabled.
# Example: https://cal.com/soval-ai/ai-clarity-consult
# Shown as an embedded calendar on /book. Redeploy after changing.
NEXT_PUBLIC_SCHEDULER_URL=

# ── Lead notification emails (Resend — https://resend.com) ───────────
# When someone submits the /book form or the quiz, we email you a lead
# notification (and, if configured, a confirmation to the lead).
# All three are required for email to send; without them the API still
# accepts the lead and logs it server-side.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=          # where YOU receive new-lead alerts, e.g. you@yourinbox.com
LEAD_FROM_EMAIL=            # verified sender, e.g. "Soval AI <hello@soval.ai>"

# ── Optional: custom analytics endpoint for trackEvent() ────────────
# Leave blank to rely on Vercel Web Analytics (toggle in the dashboard).
NEXT_PUBLIC_ANALYTICS_URL=
